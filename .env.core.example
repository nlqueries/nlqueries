# =============================================================================
# .env.core — NLQueries OSS stack environment variables
#
# Copy this file to .env.core and fill in your values.
# Used by: infra/docker-compose.core.yml
#
# Tier: [OSS]  No license required.
# =============================================================================

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
# Port the MCP server listens on (default: 8080)
MCP_PORT=8080

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Internal URL used by nlqueries-core to reach Qdrant (do not change for Docker)
QDRANT_URL=http://qdrant:6333

# ---------------------------------------------------------------------------
# Source database connection
# The database you want to query with natural language.
# Supported schemes: postgresql, mysql+pymysql, bigquery, snowflake
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/mydatabase

# ---------------------------------------------------------------------------
# LLM backend — choose one
# ---------------------------------------------------------------------------

# OpenAI (default)
OPENAI_API_KEY=sk-...

# Anthropic (optional alternative)
# ANTHROPIC_API_KEY=sk-ant-...

# Which model to use for query generation
LLM_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Knowledge base
# ---------------------------------------------------------------------------
# Directory where the auto-generated YAML knowledge base is stored
KB_PATH=/app/knowledge_base

# How often (in seconds) to refresh the knowledge base from the source DB
KB_REFRESH_INTERVAL=3600

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
