# NLQueries Core — environment variable reference
# Copy this file to .env and fill in values for local development.

# ---------------------------------------------------------------------------
# Database connections
# ---------------------------------------------------------------------------
# Not set here. Register each database with `nlqueries connect`, which writes
# the connectors file (~/.nlqueries/connectors.yaml by default) and keeps the
# password in the OS keychain where one is available. See
# docs/cli-reference.md, "connect".

# TLS for the source database is not an environment variable. The PostgreSQL
# connector requires TLS by default; set `ssl_mode` and `ssl_ca_cert` in the
# connector's entry (docs/database-hardening.md, "Transport security"). For
# AWS Aurora/RDS, `ssl_ca_cert` can point at the bundle from
#   https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# `connect mysql` sets no TLS; docs/connectors.md says how to require it.

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# Required for any Qdrant that is not on loopback — including the compose
# stack, where the app reaches it as http://qdrant:6333. Qdrant is a write path
# into the semantic cache and cached SQL runs against your database, so the app
# refuses to open its Qdrant client for a non-loopback URL without a key rather
# than talk to a remote vector store anonymously. The refusal comes on first
# use of Qdrant, not at start-up.
# Generate one with:  openssl rand -hex 32
QDRANT_API_KEY=

# Required by the compose stack, which serves the MCP server over the network:
# a networked transport will not start without authentication. Callers send it
# as `Authorization: Bearer <token>`; it has full access. Not needed for stdio
# (Claude Desktop). See docs/mcp-authentication.md.
# Generate one with:  openssl rand -hex 32
NLQ_MCP_STATIC_TOKEN=
