# NLQueries Core — environment variable reference
# Copy this file to .env and fill in values for local development.

# ---------------------------------------------------------------------------
# Database connector credentials (passed to PostgresConnector, etc.)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/mydb

# SSL transport for the source database (optional, defaults to "prefer")
# For AWS Aurora/RDS with certificate verification, download the bundle from:
#   https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# and set:
#   SSL_MODE=verify-full
#   SSL_CA_CERT=/etc/ssl/certs/rds-ca-bundle.pem
SSL_MODE=prefer
SSL_CA_CERT=

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# Required for any Qdrant that is not on loopback — including the compose
# stack, where the app reaches it as http://qdrant:6333. Qdrant is a write path
# into the semantic cache and cached SQL runs against your database, so the app
# refuses to start rather than talk to a remote vector store anonymously.
# Generate one with:  openssl rand -hex 32
QDRANT_API_KEY=
